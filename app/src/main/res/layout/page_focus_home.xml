<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <!-- 1. CLOCK & DATE (Top) -->
        <LinearLayout
            android:id="@+id/header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="64dp">

            <!-- Stacked Time -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock_time_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:lineSpacingMultiplier="0.8"
                    android:textColor="@color/black"
                    android:textSize="140sp"
                    tools:text="10" />

                <TextClock
                    android:id="@+id/clock_time_minutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-36dp"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="0.8"
                    android:textColor="#303030"
                    android:textSize="140sp"
                    tools:text="24" />
            </LinearLayout>

            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="#616161"
                android:textSize="14sp"
                tools:text="FRIDAY, OCT 24" />

            <!-- Weather -->
            <LinearLayout
                android:id="@+id/weather_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_rounded"
                android:backgroundTint="#F5F5F5"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/weather_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    tools:text="24°C • Sunny" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. YEAR MATRIX (Middle - The New Section) -->
        <LinearLayout
            android:id="@+id/year_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="150dp"
            app:layout_constraintTop_toBottomOf="@id/header_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Progress Text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2026 PROGRESS"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:textColor="#9E9E9E"/>

                <TextView
                    android:id="@+id/year_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14%"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <!-- The Grid -->
            <!-- We restrict width to make dots tight -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/year_grid_list"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:layout_gravity="center"/>

        </LinearLayout>


        <!-- 3. APPS & CONTACTS (Bottom) -->
        <LinearLayout
            android:id="@+id/actions_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/year_section"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Essential Apps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp">

                <ImageButton
                    android:id="@+id/focus_label_phone"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="#F5F5F5"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/black" />

                <Space android:layout_width="24dp" android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/focus_label_messages"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="#F5F5F5"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_messages"
                    app:tint="@color/black" />

                <Space android:layout_width="24dp" android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/focus_label_gmail"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="#F5F5F5"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gmail"
                    app:tint="@color/black" />
            </LinearLayout>

            <!-- Quick Contacts -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quick_contacts_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/add_quick_contact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="@android:color/transparent"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="+ VIP CONTACT"
                    android:textColor="#BDBDBD"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>